# times-the-calendar — frontend .env.example
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ต้องไม่ commit ขึ้น git —
# เช็คว่าอยู่ใน .gitignore แล้ว)

# ---- Backend API ----
# URL ของ backend (ดู backend/.env's PORT) — ถ้าไม่ตั้งจะ fallback เป็น
# http://localhost:4000 อัตโนมัติ (ดู api.js)
VITE_API_BASE_URL=http://localhost:4000

# ---- Firebase client SDK config (Phase 2 — Firebase Authentication) ----
# คัดลอกค่าทั้ง 6 ตัวนี้จาก Firebase Console > Project settings > General
# > Your apps > เลือก Web app (ไอคอน </>) > SDK setup and configuration
# > Config — ค่าพวกนี้ปลอดภัยที่จะ expose ฝั่ง client ตามมาตรฐานของ Firebase
# (ความปลอดภัยจริงมาจาก Firebase Auth + Security Rules ไม่ใช่การซ่อนค่านี้)
# แต่ยังเก็บใน .env แทนการ hardcode เพื่อสลับระหว่าง Firebase project
# dev/prod ได้ง่าย
#
# ต้องเปิด Google เป็น Sign-in provider ก่อนด้วย ที่ Firebase Console >
# Authentication > Sign-in method > Google > เปิดใช้งาน
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console > Project settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# หมายเหตุ: VITE_GOOGLE_CLIENT_ID เดิม (Phase 0-1, ใช้กับ Google Identity
# Services' initTokenClient โดยตรง) ไม่ต้องใช้แล้วตั้งแต่ Phase 2 — Firebase
# Auth จัดการ OAuth client ของ Google ให้เองผ่าน VITE_FIREBASE_PROJECT_ID
# ด้านบนแทน ลบตัวแปรนี้ออกจาก .env ได้เลยถ้ายังมีค้างอยู่จาก Phase ก่อนหน้า
