# ===== ใช้ตอนพัฒนาในเครื่อง (local dev) =====
PORT=4000
GOOGLE_APPLICATION_CREDENTIALS=./secrets/times-the-calendar-firebase-adminsdk-fbsvc-xxxxxxxxxx.json
FIREBASE_PROJECT_ID=times-the-calendar

# ===== ใช้ตอน deploy จริง (เช่น Render.com) แทนตัวข้างบน =====
# Hosting ส่วนใหญ่ (รวม Render free tier) ไม่มี persistent disk ให้เก็บไฟล์
# secret แบบปลอดภัย — วาง "เนื้อหาไฟล์ JSON ทั้งก้อน" เป็นค่าเดียวแทน (คัดลอก
# ทั้งไฟล์ service account มาวาง ไม่ต้องแก้ format ใดๆ) ตั้งค่านี้แทน

GOOGLE_APPLICATION_CREDENTIALS ด้านบน (ไม่ต้องตั้งทั้งคู่พร้อมกัน)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}

# โดเมนของ frontend ที่ deploy จริง (เช่น GitHub Pages) — backend ใช้จำกัด CORS
# ให้รับ request จากโดเมนนี้เท่านั้น (localhost:5173 อนุญาตไว้เสมอสำหรับ dev)

# Custom-domain production target. During migration, keep the old GitHub
# Pages origin in FRONTEND_CORS_ORIGINS; remove it after the cutover is stable.
FRONTEND_URL=https://timesapp.online/
FRONTEND_CORS_ORIGINS=https://arsenpual.github.io

# ===== Google Calendar แบบ Refresh Token (server-side OAuth) =====
# สร้าง OAuth Client type "Web application" ใน Google Cloud Console แล้วใส่
# redirect URI นี้หลังผูก Render custom domain:
# https://api.timesapp.online/oauth/google/calendar/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.timesapp.online/oauth/google/calendar/callback

# ใช้ custom domain เดียวกับ backend สำหรับ Telegram webhook หลัง DNS พร้อม
TELEGRAM_WEBHOOK_BASE_URL=https://api.timesapp.online

# สุ่มค่าใหม่สำหรับ production เท่านั้น ห้าม commit ค่าแท้จริง:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOOGLE_OAUTH_STATE_SECRET=

# backend/.env สำหรับทดสอบ local
FRONTEND_URL=http://localhost:5173
FRONTEND_CORS_ORIGINS=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/google/calendar/callback

# ===== Gemini Developer API (Google AI Studio) =====
# Server-only key; เลือก project ที่มี Free Tier ใน AI Studio
# เก็บ service-account ของ Firebase เดิมไว้สำหรับ Firestore
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini ใช้เฉพาะนักพัฒนา ทั้ง local และ production (Firebase UID คั่นด้วย comma)
# ว่าง = ปิดให้ทุกคน; GEMINI_CHAT_ALLOWED_UIDS/ALLOW_LOCAL_DEVELOPMENT เดิมไม่มีผล
GEMINI_CHAT_DEVELOPER_UIDS=
GEMINI_CHAT_ENABLED=true
