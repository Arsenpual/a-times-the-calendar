# ===== ใช้ตอนพัฒนาในเครื่อง (local dev) =====
PORT=4000
GOOGLE_APPLICATION_CREDENTIALS=./secrets/times-the-calendar-firebase-adminsdk-fbsvc-xxxxxxxxxx.json
FIREBASE_PROJECT_ID=times-the-calendar

# ===== ใช้ตอน deploy จริง (เช่น Render.com) แทนตัวข้างบน =====
# Hosting ส่วนใหญ่ (รวม Render free tier) ไม่มี persistent disk ให้เก็บไฟล์
# secret แบบปลอดภัย — วาง "เนื้อหาไฟล์ JSON ทั้งก้อน" เป็นค่าเดียวแทน (คัดลอก
# ทั้งไฟล์ service account มาวาง ไม่ต้องแก้ format ใดๆ) ตั้งค่านี้แทน

GOOGLE_APPLICATION_CREDENTIALS ด้านบน (ไม่ต้องตั้งทั้งคู่พร้อมกัน)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}

# โดเมนของ frontend ที่ deploy จริง (เช่น GitHub Pages) — backend ใช้จำกัด CORS
# ให้รับ request จากโดเมนนี้เท่านั้น (localhost:5173 อนุญาตไว้เสมอสำหรับ dev)

FRONTEND_URL=https://arsenpual.github.io/a-times-the-calendar/

# ===== Google Calendar แบบ Refresh Token (server-side OAuth) =====
# สร้าง OAuth Client type "Web application" ใน Google Cloud Console แล้วใส่
# redirect URI นี้: https://<your-render-service>.onrender.com/oauth/google/calendar/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://times-the-calendar-backend.onrender.com/oauth/google/calendar/callback

# สุ่มค่าใหม่สำหรับ production เท่านั้น ห้าม commit ค่าแท้จริง:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOOGLE_OAUTH_STATE_SECRET=

# backend/.env สำหรับทดสอบ local
FRONTEND_URL=http://localhost:5173
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/oauth/google/calendar/callback

# ===== Gemini / Vertex AI =====
# ใช้ Google service-account ตัวเดียวกับ GOOGLE_APPLICATION_CREDENTIALS ได้
# โดย service account นั้นต้องมีสิทธิ์ Vertex AI User ใน Google Cloud
GOOGLE_CLOUD_PROJECT=times-the-calendar
GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-2.5-flash-lite

# Production ต้องระบุ Firebase UID ที่อนุญาตเท่านั้น (คั่นด้วย comma)
GEMINI_CHAT_ALLOWED_UIDS=
# เปิดได้เฉพาะตอนรัน backend ในเครื่อง และจะไม่ทำงานหาก NODE_ENV=production
# ห้ามนำค่านี้ไปใส่ใน Render.com
GEMINI_CHAT_ALLOW_LOCAL_DEVELOPMENT=false
