# ============================================================================
# T.i.M.E.S. — Unified Environment & Google AI Studio Secrets Template
# ============================================================================
# วิธีใช้งาน:
#   1. บน Google AI Studio: นำชื่อคีย์ด้านล่างไปใส่ในช่อง "Secrets" ของ AI Studio ได้เลย
#   2. บน Localhost (รันจากโฟลเดอร์ราก `npm run dev`): คัดลอกไฟล์นี้เป็น `.env` ที่โฟลเดอร์ราก
#      (หรือแยกไว้ที่ `backend/.env` และ `frontend/.env` ก็ได้ ระบบอ่านให้อัตโนมัติทั้งสองจุด)
#
# ข้อกำหนดความปลอดภัย:
#   - ห้าม commit ไฟล์ `.env` หรือคีย์จริงลงใน Git เด็ดขาด (ถูกยกเว้นใน `.gitignore` แล้ว)
#   - คีย์ฝั่ง Backend (เช่น GEMINI_API_KEY, GOOGLE_APPLICATION_CREDENTIALS_JSON)
#     จะถูกอ่านเฉพาะใน Node.js Server เท่านั้น ไม่ถูกส่งออกไปที่ Browser Bundle
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Gemini Developer API (Server-Only Secret — ใช้ใน Cozy Desk & Activity AI)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_ENABLED=true
# Firebase UID ของนักพัฒนาที่อนุญาตให้ใช้แชต AI (คั่นด้วย comma หากมีหลายบัญชี)
GEMINI_CHAT_DEVELOPER_UIDS=

# ----------------------------------------------------------------------------
# 2. Firebase Admin SDK / Firestore (Server-Only Secret)
# ----------------------------------------------------------------------------
# สำหรับ Google AI Studio Secrets หรือ Cloud Deploy (Render.com):
# วางเนื้อหาไฟล์ Service Account JSON ทั้งก้อนในบรรทัดเดียว (หรือแปลงเป็น Base64 ก็ได้)
# หมายเหตุ: ระบบจะดึง `project_id` จากใน JSON นี้ให้อัตโนมัติแม้ไม่ได้ตั้ง FIREBASE_PROJECT_ID แยก
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# สำหรับ Localhost Development (ทางเลือก: ชี้ไปยังไฟล์ JSON บนเครื่องแทน _JSON ด้านบน):
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
FIREBASE_PROJECT_ID=

# ----------------------------------------------------------------------------
# 3. Firebase Web Client Config (ใช้ยืนยันตัวตน Google Sign-In ฝั่ง Frontend)
# ----------------------------------------------------------------------------
# สามารถตั้งชื่อแบบมี VITE_ นำหน้า (มาตรฐาน Vite) หรือไม่มี VITE_ ก็ได้ (vite.config.js รองรับทั้งคู่)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ----------------------------------------------------------------------------
# 4. Server Port, Frontend URL & CORS (สำหรับ Localhost / Production)
# ----------------------------------------------------------------------------
PORT=4000
FRONTEND_URL=http://localhost:5173
FRONTEND_CORS_ORIGINS=
# ปล่อยว่างได้เมื่อรันผ่าน Vite Proxy หรือ Same-Origin; ตั้งเป็น http://localhost:4000 ได้หากรันแยกพอร์ต
# VITE_API_BASE_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# 5. Google Calendar Server-Side OAuth (ทางเลือก — สำหรับเชื่อมต่อ Google Calendar)
# ----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/google/calendar/callback
# สุ่มค่า 32-byte ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=
# สุ่มค่าด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOOGLE_OAUTH_STATE_SECRET=

# ----------------------------------------------------------------------------
# 6. Telegram Bot & Weather API (ทางเลือก — สำหรับแจ้งเตือนและพยากรณ์อากาศ)
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_FREE_AI_ALLOWED_CHAT_IDS=
TELEGRAM_FREE_AI_SYSTEM_INSTRUCTION=
GOOGLE_WEATHER_API_KEY=
