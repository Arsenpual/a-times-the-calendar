# ============================================================================
# T.i.M.E.S. — Compact AI Studio Secrets Template (Fits well within 10-secret limit)
# Localhost .env still supports all individual env vars as before.
# ============================================================================

# 1. Firebase Web Client Config (Single JSON or Base64 JSON for all 6-7 VITE_FIREBASE_* keys)
# Example: {"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"...","vapidKey":"..."}
FIREBASE_WEB_CONFIG_JSON=

# 2. Firebase Admin SDK Service Account (Single-line JSON or Base64 JSON)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# 3. Gemini Developer API (Server-Only Secret — managed in Settings > Secrets on AI Studio)
GEMINI_API_KEY=

# 4. Optional Backend Settings Bundle (Single JSON or Base64 JSON for OAuth, Gemini options, Weather, Telegram)
# Example: {"GEMINI_MODEL":"gemini-4-hydrogen","GEMINI_CHAT_ENABLED":"true","GEMINI_CHAT_DEVELOPER_UIDS":"...","GOOGLE_OAUTH_CLIENT_ID":"...","GOOGLE_OAUTH_CLIENT_SECRET":"...","GOOGLE_OAUTH_REDIRECT_URI":"...","CALENDAR_TOKEN_ENCRYPTION_KEY":"...","GOOGLE_OAUTH_STATE_SECRET":"...","FRONTEND_URL":"...","GOOGLE_WEATHER_API_KEY":"..."}
TIMES_BACKEND_CONFIG_JSON=

# 4. Optional fallback if GOOGLE_APPLICATION_CREDENTIALS_JSON is truncated by secret length limit
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=